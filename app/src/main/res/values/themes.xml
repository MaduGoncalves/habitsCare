<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal da aplicação -->
    <style name="Theme.HabitsCare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_green_primary</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Estilo Padrão para os Botões do App -->
    <style name="EstiloBotaoPadrao" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Tema exclusivo para a Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_app</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_leaf</item>
        <item name="postSplashScreenTheme">@style/Theme.HabitsCare</item>
    </style>
</resources>