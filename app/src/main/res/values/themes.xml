<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal da aplicação -->
    <style name="Theme.HabitsCare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_green_primary</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- Estilo Padrão para os Botões do App -->
    <style name="EstiloBotaoPadrao" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Tema exclusivo para a Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_app</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_leaf</item>
        <item name="postSplashScreenTheme">@style/Theme.HabitsCare</item>
    </style>

    <!-- Tema do menu popup da Toolbar -->
    <style name="SettingsPopUp" parent="ThemeOverlay.MaterialComponents.Light" />

    <!--   CARDS  -->
    <style name="cards">
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- TITULOS -->
    <style name="titulos">
        <item name="android:textColor">#005B41</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- TEXTOS -->
    <style name="textos">
        <item name="android:textColor">#707977</item>
    </style>

    <style name="background">
        <item name="android:background">#EAF5F2</item>
    </style>

    <style name="BotaoTextoLembretes" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/brand_green_primary</item>
    </style>

    <style name="MenuInferior" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">#FFFFFF</item>
        <item name="itemRippleColor">#1A005B41</item>
    </style>

    <style name="BarraSuperior" parent="Widget.Design.AppBarLayout">
        <item name="android:background">@color/brand_green_primary</item>
        <item name="elevation">0dp</item>
    </style>
</resources>