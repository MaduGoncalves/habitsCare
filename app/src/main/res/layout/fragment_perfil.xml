<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp"
    style="@style/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <!-- Título da tela -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Perfil"
            android:textSize="26sp"
            style="@style/titulos" />

        <!-- Card de informações do usuário -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/cards"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Foto e informações do usuário -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivFoto"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@color/bg_input"
                        android:contentDescription="Foto de perfil"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_pessoa"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.HabitsCare.Circle"
                        app:strokeColor="@color/brand_green_primary"
                        app:strokeWidth="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNomeTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="22sp"
                            tools:text="teste"
                            style="@style/titulos"/>

                        <TextView
                            android:id="@+id/tvEmailSubtitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="14sp"
                            style="@style/textos"
                            tools:text="teste@gmail.com" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Botão para alterar foto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAlterarFoto"
                    style="@style/BotaoTextoLembretes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="Alterar foto"
                    android:textAllCaps="false"/>

                <!-- Campo Nome -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNome"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome"
                    android:textColorHint="@color/text_hint"
                    app:boxBackgroundColor="@color/bg_input"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/box_stroke_perfil"
                    app:hintTextColor="@color/brand_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textColor="@color/text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo E-mail -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="E-mail"
                    android:textColorHint="@color/text_hint"
                    app:boxBackgroundColor="@color/bg_input"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/box_stroke_perfil"
                    app:hintTextColor="@color/brand_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Senha -->

                <!-- Botão Salvar -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSenha"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Nova senha"
                    android:textColorHint="@color/text_hint"
                    app:boxBackgroundColor="@color/bg_input"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/box_stroke_perfil"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_secondary"
                    app:helperText="Deixe em branco para manter a senha atual"
                    app:helperTextEnabled="true"
                    app:helperTextTextColor="@color/brand_green_dark"
                    app:hintTextColor="@color/brand_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:enabled="false"
                    android:text="Salvar alterações"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/brand_green_dark"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card de Lembretes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/cards"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lembretes"
                    style="@style/titulos"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Notificações para ajudar nos seus hábitos"
                    style="@style/textos"
                    android:textSize="14sp" />

                <!-- Hora de dormir -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSono"
                    style="@style/titulos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Hora de dormir"
                    android:textSize="16sp"
                    app:useMaterialThemeColors="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHoraSono"
                    style="@style/BotaoTextoLembretes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Horário: 22:00"
                    android:textAllCaps="false" />

                <!-- Beber água -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAgua"
                    style="@style/titulos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Beber água"
                    android:textSize="16sp"
                    app:useMaterialThemeColors="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIntervaloAgua"
                    style="@style/BotaoTextoLembretes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="A cada 2 horas · das 8h às 22h"
                    android:textAllCaps="false" />

                <!-- Hora de caminhar -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCaminhada"
                    style="@style/titulos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Hora de caminhar"
                    android:textSize="16sp"
                    app:useMaterialThemeColors="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHoraCaminhada"
                    style="@style/BotaoTextoLembretes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Horário: 20:00"
                    android:textAllCaps="false" />

                <!-- Aviso de permissão de alarme exato -->
                <TextView
                    android:id="@+id/tvAvisoLembretes"
                    style="@style/titulos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Alarmes exatos não permitidos: os lembretes podem atrasar alguns minutos. Toque para permitir."
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botão Sair -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSair"
            android:backgroundTint="@color/danger"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Sair"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>