<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- LOGO (ic_leaf) -->
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_leaf"
            app:tint="@color/brand_green_primary" />

        <!-- NOME DO APP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/brand_green_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- SLOGAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp"
            android:text="@string/app_slogan"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- E-MAIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_email"
            android:textColor="@color/brand_green_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- CAMPO E-MAIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <!-- Ícone com as cores originais da imagem (sem tint) -->
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/ic_email" />

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingStart="7dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_senha"
            android:textColor="@color/brand_green_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- CAMPO SENHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <!-- Ícone com as cores originais da imagem (sem tint) -->
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lock" />

            <EditText
                android:id="@+id/editSenha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_senha"
                android:inputType="textPassword"
                android:paddingStart="7dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- BOTÃO ENTRAR -->
        <Button
            android:id="@+id/buttonLogin"
            style="@style/EstiloBotaoPadrao"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/brand_green_primary"
            android:text="@string/btn_login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- LINHA DIVISÓRIA SIMPLIFICADA -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/border_input" />

        <!-- BOTÃO CADASTRO -->
        <Button
            android:id="@+id/buttonCadastro"
            style="@style/EstiloBotaoPadrao"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:backgroundTint="@color/brand_green_dark"
            android:text="Criar Conta"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <!-- BOTÃO SEGUIR SEM LOGIN -->
        <TextView
            android:id="@+id/textSeguirSemLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="@string/btn_continue_without_login"
            android:textColor="@color/brand_green_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- RODAPÉ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="@string/app_name"
        android:textColor="@color/brand_green_primary"
        android:textSize="16sp" />

</LinearLayout>