<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_leaf"
                app:tint="@color/brand_green_leaf" />

            <!-- Nome da Aplicação -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/brand_green_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Slogan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="@string/app_slogan"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Campo E-mail -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColorHint="@color/text_hint" />

            <!-- Campo Senha -->
            <EditText
                android:id="@+id/etSenha"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_senha"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColorHint="@color/text_hint" />

            <!-- Botão Entrar -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/brand_green_primary"
                android:text="@string/btn_login"
                android:textColor="@color/white"
                app:cornerRadius="25dp" />

            <!-- Botão Continuar sem Login -->
            <Button
                android:id="@+id/btnContinueWithoutLogin"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_continue_without_login"
                android:textColor="@color/brand_green_primary" />

            <!-- Nota do Protótipo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/prototype_notice"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>